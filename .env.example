# Copy to .env (which is git-ignored) and fill in. Never commit real keys.
ANTHROPIC_API_KEY=your-key-here
# Pin the exact model version used for extraction so results are repeatable.
ANTHROPIC_MODEL=claude-sonnet-5-5
# 0 = most repeatable. Set to an empty value if your model version does not accept the parameter.
EXTRACTION_TEMPERATURE=0
